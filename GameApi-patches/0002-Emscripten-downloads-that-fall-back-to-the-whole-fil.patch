+  // The server gave no Content-Range for the "bytes=0-0" probe (no range support, or the
+  // header is not exposed), or the probe failed: fetch the file in one piece.
+  void no_range()
+  {
+    async_pending_count--;
+    std::cout << "Warning: You probably don't have http Range requests enabled!" << std::endl;
+    std::cout << "Recommended solution (in .htaccess):" << std::endl;
+    std::cout << "<IfModule mod_headers.c>" << std::endl;
+    std::cout << "   Header set Access-Control-Expose-Headers \"Content-Length, Content-Range\""<< std::endl;
+    std::cout << "</IfModule>" << std::endl;
+    gave_up = true;
+    failed_after_size(0,-1);
+  }
+  bool gave_up = false;
 public:
   std::string url;
   std::string url2;
@@ -1924,6 +1947,7 @@ EMSCRIPTEN_KEEPALIVE
 extern "C" void head_result(const char *ptr, void *data)
 {
   FetchInBlocks *blk = (FetchInBlocks *)data;
+  if (!ptr || !*ptr) { blk->no_range(); return; } // JS passes null when there is no Content-Range
   std::string s(ptr);
   blk->head_result(s);
 }
@@ -1931,7 +1955,7 @@ EMSCRIPTEN_KEEPALIVE
