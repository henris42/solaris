@@ -1889,20 +1891,41 @@ public:
   {
     async_pending_count--;
     std::cout << "fetch_failed" << std::endl;
+    // this request is over whatever comes next: its user data and the fetch itself are freed here
+    FetchInBlocksUserData *ptr = fetch ? (FetchInBlocksUserData*)(fetch->userData) : 0;
+    int blk = ptr ? ptr->block_num : -1;
